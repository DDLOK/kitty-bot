DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_server_id_here

# Lavalink (music) — defaults to a public node. Override to use your own.
LAVALINK_URI=https://lavalinkv4.serenetia.com:443
LAVALINK_PASSWORD=https://dsc.gg/ajidevserver

# Optional — your own Cloudflare Worker for pretty share pages.
# Deploy the worker in cloudflare-worker/ first (see its README).
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_WORKER_SECRET=

# ===== EZLARP login (website Discord OAuth) =====
# BOT_TOKEN defaults to DISCORD_TOKEN above if left blank.
BOT_TOKEN=
# CLIENT_ID = your Discord Application ID (dev portal).
CLIENT_ID=
# CLIENT_SECRET from dev portal → OAuth2 → Reset Secret.
CLIENT_SECRET=
# Optional: role to apply when users join the server via /login.
MEMBER_ROLE_ID=
# AUTH_SECRET — HS256 signing secret. MUST exactly match AUTH_SECRET on Cloudflare.
AUTH_SECRET=
# Public HTTPS URL the bot web server is reachable at (e.g. Cloudflare Tunnel URL).
# No trailing slash. Example: https://kitty-bot.example.com
PUBLIC_URL=
# Local port the web server binds to. Default 8080.
PORT=8080
