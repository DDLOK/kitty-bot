DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
GUILD_ID=your_server_id_here

# Optional — ]describe (image → text). Pick one, OpenRouter preferred.
# OpenRouter: https://openrouter.ai/keys (free, Gemini/Llama/Qwen vision models)
OPENROUTER_KEY=
# Groq: https://console.groq.com/keys (free, Llama 4 Scout/Maverick)
GROQ_KEY=

# Optional — enables Spotify PLAYLIST/ALBUM links in ]play.
# Spotify track links work WITHOUT these. Playlists need both.
# Get them at https://developer.spotify.com/dashboard → Create App
SPOTIFY_ID=
SPOTIFY_SECRET=
